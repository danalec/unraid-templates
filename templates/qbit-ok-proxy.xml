<?xml version="1.0"?>
<Container version="2">
  <Name>qbit-ok-proxy</Name>
  <Repository>python:3-alpine</Repository>
  <Registry>https://hub.docker.com/_/python</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <MyMAC/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support/>
  <Project/>
  <ReadMe/>
  <Overview>Mini reverse proxy that restores the qBittorrent legacy "Ok." login response for the Bookshelf/Readarr download client.</Overview>
  <Category>Tools:Utilities</Category>
  <WebUI>http://[IP]:[PORT:8081]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/danalec/unraid-templates/main/templates/qbit-ok-proxy.xml</TemplateURL>
  <Icon>https://www.python.org/static/community_logos/python-logo-master-v3-TM.png</Icon>
  <ExtraParams>--entrypoint python3</ExtraParams>
  <PostArgs>-u /app/qbit-ok-proxy.py</PostArgs>
  <CPUset/>
  <Requires>Depends on /boot/config/scripts/qbit-ok-proxy.py existing on the flash drive.</Requires>
  <Config Name="Port" Target="8081" Default="8081" Mode="tcp" Description="Proxy listen port" Type="Port" Display="always" Required="false" Mask="false">8081</Config>
  <Config Name="Script" Target="/app/qbit-ok-proxy.py" Default="/boot/config/scripts/qbit-ok-proxy.py" Mode="ro" Description="Proxy script (read-only)." Type="Path" Display="always" Required="true" Mask="false">/boot/config/scripts/qbit-ok-proxy.py</Config>
  <TailscaleStateDir/>
</Container>\n