<?xml version="1.0"?>
<Container version="2">
  <Name>SearXNG</Name>
  <Repository>searxng/searxng</Repository>
  <Registry>https://hub.docker.com/r/searxng/searxng</Registry>
  <Network>br0</Network>
  <MyIP>192.168.0.20</MyIP>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://forums.unraid.net/topic/130158-support-kilrahsearxng/</Support>
