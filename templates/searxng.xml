  <WebUI>http://[IP]:[PORT:80]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/danalec/unraid-templates/main/templates/searxng.xml</TemplateURL>
  <Icon>https://github.com/kilrah/unraid-docker-templates/raw/main/icons/searxng.png</Icon>
