  <Config Name="SearXNG Instance Name" Target="INSTANCE_NAME" Default="searxng" Mode="" Description="Instance name" Type="Variable" Display="always" Required="false" Mask="false">searxng</Config>
  <TailscaleStateDir/>
</Container>\n